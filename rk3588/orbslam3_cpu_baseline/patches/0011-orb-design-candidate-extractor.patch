+#ifdef ORB_DESIGN_CANDIDATES
+    float ORBextractor::DesignQuantize(float angle,int bins)
+    {
+        if(bins==0) return angle;
+        if(bins<1 || bins>360 || angle<0 || angle>=360)
+            throw std::runtime_error("Invalid design-candidate angle/bins");
+        const float step=360.f/bins;
+        const int k=int(std::floor((angle+180.f/bins)/step))%bins;
+        return k*step;
+    }
+
+    Mat ORBextractor::DesignBox2(const Mat& image,int rounding)
+    {
+        if(image.type()!=CV_8UC1 || image.cols%2 || image.rows%2 || (rounding!=0 && rounding!=1))
+            throw std::runtime_error("P2 requires even 8-bit grayscale dimensions and explicit rounding");
+        Mat result(image.rows/2,image.cols/2,CV_8UC1);
+        for(int y=0;y<result.rows;++y) for(int x=0;x<result.cols;++x) {
+            const int sum=int(image.at<uchar>(2*y,2*x))+image.at<uchar>(2*y,2*x+1)
+                         +image.at<uchar>(2*y+1,2*x)+image.at<uchar>(2*y+1,2*x+1);
+            result.at<uchar>(y,x)=uchar((sum+(rounding?2:0))/4);
+        }
+        return result;
+    }
+
+    static bool designRaster(const KeyPoint& a,const KeyPoint& b) {
+        return a.pt.y<b.pt.y || (a.pt.y==b.pt.y && a.pt.x<b.pt.x);
+    }
+
+    vector<KeyPoint> ORBextractor::DesignGrid(const vector<KeyPoint>& keys,
+                                             int width,int height,int budget,DesignLayer& stats)
+    {
+        if(width<=0 || height<=0 || budget<=0) throw std::runtime_error("Invalid G grid geometry/budget");
+        stats.width=width;stats.height=height;stats.budget=budget;stats.candidates=keys.size();
+        stats.cell_side=std::max(1,int(std::floor(std::sqrt(double(width)*height/budget))));
+        // Remainders are merged into the LAST full cell, not appended as new cells.
+        stats.cell_cols=std::max(1,width/stats.cell_side);stats.cell_rows=std::max(1,height/stats.cell_side);
+        vector<int> best(stats.cell_cols*stats.cell_rows,-1);
+        for(size_t i=0;i<keys.size();++i) {
+            const auto& k=keys[i];
+            if(k.pt.x<0 || k.pt.x>=width || k.pt.y<0 || k.pt.y>=height)
+                throw std::runtime_error("Candidate outside original effective area");
+            int x=std::min(int(k.pt.x)/stats.cell_side,stats.cell_cols-1);
+            int y=std::min(int(k.pt.y)/stats.cell_side,stats.cell_rows-1);
+            int& previous=best[y*stats.cell_cols+x];
+            if(previous<0 || k.response>keys[previous].response ||
+               (k.response==keys[previous].response && designRaster(k,keys[previous]))) previous=i;
+        }
+        vector<KeyPoint> result;
+        stats.empty_cells=0;
+        for(int i:best) { if(i<0) ++stats.empty_cells; else result.push_back(keys[i]); }
+        if(int(result.size())>budget) {
+            std::stable_sort(result.begin(),result.end(),[](const KeyPoint& a,const KeyPoint& b) {
+                return a.response>b.response || (a.response==b.response && designRaster(a,b));
+            });
+            result.resize(budget);
+        }
+        stats.selected=result.size();stats.shortfall=std::max(0,budget-stats.selected);
+        return result;
+    }
+
+    ORBextractor::DesignLayer ORBextractor::DesignProbeLevel0(const Mat& image,int threshold)
+    {
+        if(image.type()!=CV_8UC1 || threshold<0 || threshold>255)
+            throw std::runtime_error("Invalid FAST probe input");
+        const int border=EDGE_THRESHOLD-3,width=image.cols-2*border,height=image.rows-2*border;
+        const int cols=width/35,rows=height/35;
+        if(cols<1 || rows<1) throw std::runtime_error("Image too small for original FAST tiling");
+        const int wc=std::ceil(float(width)/cols),hc=std::ceil(float(height)/rows);
+        vector<KeyPoint> candidates;
+        for(int y=0;y<rows;++y) {
+            const int iy=border+y*hc,my=std::min(iy+hc+6,image.rows-border);
+            if(iy>=image.rows-border-3) continue;
+            for(int x=0;x<cols;++x) {
+                const int ix=border+x*wc,mx=std::min(ix+wc+6,image.cols-border);
+                if(ix>=image.cols-border-6) continue;
+                vector<KeyPoint> cell;FAST(image.rowRange(iy,my).colRange(ix,mx),cell,threshold,true);
+                for(auto k:cell) { k.pt.x+=x*wc;k.pt.y+=y*hc;candidates.push_back(k); }
+            }
+        }
+        DesignLayer stats;DesignGrid(candidates,width,height,mnFeaturesPerLevel[0],stats);return stats;
+    }
+#endif
